# PolyBot — конфигурация

# paper = учебные деньги на живом стакане. live = реальный кошелёк.
# DRY_RUN=true оставляет paper, даже если TRADING_MODE=live.
TRADING_MODE=paper
DRY_RUN=false

# Бумажный банк. В live первый запуск берёт свободный залог с биржи.
BANKROLL_USD=2750

# Единственная стратегия лестницы. lockin и hybrid игнорируются (см. docs/STRATEGY_ANALYSIS.md).
STRATEGY_PRESET=mo_money

# maker_ladder — текущие мейкер-биды. copy_wallet — бумажный тейкер по
# фаворитным покупкам кошелька. copy_wallet никогда не включает LIVE.
STRATEGY=maker_ladder
COPY_WALLET=0x32ed2e546b187ca15e2841edc82b22c713cf8ec3
COPY_MIN_PRICE=0.50
COPY_MAX_PRICE=0.95
COPY_MIN_T=0
COPY_MAX_T=240
COPY_SHARES=10
COPY_MAX_PER_WINDOW=3
# Empty = our equity / the wallet's portfolio value, once per UTC day.
# Set a number to override, for example 0.01.
COPY_SCALE=
COPY_DELAY_S=1
COPY_MAX_SLIP=0.03

# За 14–20 ноября 2026 кошелёк держит сразу несколько окон: медиана 4, бывает до 12.
# Деньги почти все в BTC 5m и 15m, но ETH/SOL/XRP и окна 1h/4h тоже открыты.
# DOGE, BNB и сутки включаются теми же переменными, в дефолт не входят.
ENABLED_ASSETS=BTC,ETH,SOL,XRP
ENABLED_TIMEFRAMES=5m,15m,1h,4h
AUTO_START=true

# Лимиты под банк $2750 и несколько окон сразу. Размер кошелька не копируется.
ORDER_CLIP_USD=16
MAX_WINDOW_RISK_USD=80
MAX_TOTAL_EXPOSURE_USD=640
MAX_DAILY_LOSS_USD=160
MAX_CONSECUTIVE_LOSSES=10
MIN_MERGE_SHARES=1
# Вторая нога, когда первая уже куплена. Допустимо от 0.90 до 1.20.
# Прогон 24 часов: 0.97 на одних 5m. На Railway это задаёт владелец отдельно.
PAIR_SUM_HEDGE=1.00
# Лестница фаворита. На Railway владелец задаёт ENABLED_ASSETS=BTC отдельно.
LADDER_RUNGS=6
LADDER_STEP=0.01
RUNG_SHARES=10
# Секунды, которые строка должна пролежать на полной ленте, прежде чем
# мы решим, что это maker BUY. Тейкерская строка иногда доезжает позже.
TAPE_SETTLE_S=6

# Одноразовая зачистка старых файлов на томе. Пусто = ничего не удалять.
# Не указывайте текущий DB_PATH и его -wal/-shm — они и так защищены.
# LEGACY_DB_DELETE=/data/polybot.db,/data/polybot.db-wal,/data/polybot.db-shm
# PAPER_RESET_ONCE / PAPER_RESET_ID читаются и игнорируются: база на томе не стирается.
# PAPER_STATS_SINCE_TS — нижняя граница статистики, строки не удаляются.

# Газ merge/redeem в live без релеера. 0 = не выдумывать цену POL.
ONCHAIN_GAS_USD=0

POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_PIN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local default. On Railway the owner sets a fresh file and deletes the previous one:
# DB_PATH=/data/polybot_v11.db
# LEGACY_DB_DELETE=/data/polybot_v10.db,/data/polybot_v10.db-wal,/data/polybot_v10.db-shm
DB_PATH=data/polybot.db
