# =============================================================================
# PolyBot TWAP Hybrid — Конфигурация (.env)
# Архитектура: @mo-money (Post-Only Maker + MERGE) + @Bonereaper (TWAP Lock-In)
#              + @dangerously-skip-permissions (лимиты риска и инвентаря)
# =============================================================================

# Режим работы: "paper" (виртуальный счёт на РЕАЛЬНЫХ живых котировках) или "live"
# ВАЖНО: первые 5-7 дней ОБЯЗАТЕЛЬНО гоняйте в режиме paper!
TRADING_MODE=paper

# Стартовый виртуальный банк для paper-режима (в pUSD / USD; €2500 ≈ $2750)
# Для первого запуска в live рекомендуется начинать с $200-$300!
BANKROLL_USD=2750

# Пресет стратегии:
#   mo_money   — Базовый (95%+ Post-Only Maker + синтетический TP/SL + авто-MERGE + TWAP Lock-In)
#   lockin     — Консервативный (только высоковероятные входы 95-98¢ при фиксации 60s TWAP + редкий Maker)
#   hybrid     — Активный (mo_money + выборочный Taker при большом перевесе, особенно на ETH/SOL с комиссией 0.01)
STRATEGY_PRESET=mo_money

# Активы для торговли (через запятую: BTC,ETH,SOL)
# После 20.11.2026 23:59 UTC комиссия тейкера на ETH и SOL падает в 7 раз (с 0.07 до 0.01)!
ENABLED_ASSETS=BTC,ETH,SOL

# Таймфреймы окон (через запятую: 5m,15m)
ENABLED_TIMEFRAMES=5m

# Автозапуск торговли при старте процесса (true / false)
AUTO_START=true

# -----------------------------------------------------------------------------
# РИСК-МЕНЕДЖМЕНТ (жёсткие предохранители в стиле @DSP)
# -----------------------------------------------------------------------------
# Базовый размер одного клипа в USD (минимум на Polymarket — 5 акций)
ORDER_CLIP_USD=18

# Максимальный риск (нетто-позиция) в одном 5m-окне в USD (~2.2% от банка $2750)
MAX_WINDOW_RISK_USD=60

# Максимальная суммарная загрузка капитала по всем открытым рынкам одновременно (USD)
MAX_TOTAL_EXPOSURE_USD=350

# Дневной стоп-лосс в USD: при достижении бот снимает все ордера и встаёт на паузу (~3.5% банка)
MAX_DAILY_LOSS_USD=95

# Пауза после N убыточных окон подряд (0 = выкл)
MAX_CONSECUTIVE_LOSSES=6

# -----------------------------------------------------------------------------
# LIVE TRADING (заполнять только когда переходите в live!)
# -----------------------------------------------------------------------------
# Приватный ключ отдельного кошелька ТОЛЬКО под бота (никогда основной!)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Опционально: Relayer / Builder ключи для безгазовых merge/redeem
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# -----------------------------------------------------------------------------
# УПРАВЛЕНИЕ С iPHONE / iPAD (Веб-панель + Telegram-бот)
# -----------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
# Локально / VPS: 8080. На Railway переменная PORT подставляется автоматически и имеет приоритет.
DASHBOARD_PORT=8080
# Задайте секретный PIN/пароль (6 цифр), чтобы никто чужой не нажимал кнопки в панели!
DASHBOARD_PIN=

# Telegram-бот (создаётся за 1 минуту через @BotFather прямо с iPhone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Путь к базе данных SQLite (история всех сделок, мерджей и PnL)
# На Railway обязательно: /data/polybot.db + Volume с mount path /data
DB_PATH=data/polybot.db
