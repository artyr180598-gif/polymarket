# PolyBot — конфигурация

# paper = учебные деньги на живом стакане. live = реальный кошелёк.
# DRY_RUN=true оставляет paper, даже если TRADING_MODE=live.
TRADING_MODE=paper
DRY_RUN=false

# Бумажный банк. В live первый запуск берёт свободный залог с биржи.
BANKROLL_USD=2750

# Единственная стратегия. lockin и hybrid игнорируются (см. docs/STRATEGY_ANALYSIS.md).
STRATEGY_PRESET=mo_money

# Кошелёк mo-money в последние сутки почти весь в BTC 5m/15m.
# Дополнительно на истории плюсуют ETH, SOL, XRP, DOGE, BNB и окна 1h, 4h, 1d.
ENABLED_ASSETS=BTC
ENABLED_TIMEFRAMES=5m,15m
AUTO_START=true

# Лимиты под банк около $2750. Размер кошелька-образца не копируется.
ORDER_CLIP_USD=16
MAX_WINDOW_RISK_USD=140
MAX_TOTAL_EXPOSURE_USD=420
MAX_DAILY_LOSS_USD=160
MAX_CONSECUTIVE_LOSSES=10
MIN_MERGE_SHARES=1

# Газ merge/redeem в live без релеера. 0 = не выдумывать цену POL.
# PAPER_RESET_ONCE / PAPER_RESET_ID читаются и игнорируются: база на томе не стирается.
# PAPER_STATS_SINCE_TS — нижняя граница статистики, строки не удаляются.
ONCHAIN_GAS_USD=0

POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_PIN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Railway: том /data и DB_PATH=/data/polybot.db
DB_PATH=data/polybot.db
