# =============================================================================
# PolyBot TWAP Hybrid — Конфигурация (.env)
# =============================================================================

# Режим: paper = демо на живых котировках Polymarket | live = реальный кошелёк
TRADING_MODE=paper

# Демо-банк (виртуальные USD). Для старта удобно 2000.
BANKROLL_USD=2000

# Пресет: mo_money | lockin | hybrid
# mo_money = лента @mo-money: BTC 5m+15m, BUY фаворита, хедж, MERGE, без SELL
STRATEGY_PRESET=mo_money

ENABLED_ASSETS=BTC
ENABLED_TIMEFRAMES=5m,15m
AUTO_START=true

# Размер под банк ~$2000–2750. Кошелёк mo-money крутит ~$9k/час — это НЕ копируется.
ORDER_CLIP_USD=16
MAX_WINDOW_RISK_USD=140
MAX_TOTAL_EXPOSURE_USD=420
MAX_DAILY_LOSS_USD=160
MAX_CONSECUTIVE_LOSSES=10

POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_PIN=

# Telegram — создай бота через @BotFather, chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Railway: /data/polybot.db + Volume /data
DB_PATH=data/polybot.db
