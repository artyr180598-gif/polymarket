# PolyBot — конфигурация

# paper = учебные деньги на живом стакане. live = реальный кошелёк.
# DRY_RUN=true оставляет paper, даже если TRADING_MODE=live.
# copy_wallet всегда работает только на бумаге: LIVE для него не включается.
TRADING_MODE=paper
DRY_RUN=false

# Бумажный банк: 2750. В live первый запуск берёт свободный залог с биржи.
# Новая база стартует с этой суммой; уже созданная база хранит свою.
# Для 1:1 банк должен покрывать все одновременные окна кошелька.
BANKROLL_USD=2750

# copy_wallet — зеркало одного кошелька (по умолчанию). maker_ladder — старая
# лестница из docs/STRATEGY_ANALYSIS.md. lockin и hybrid игнорируются.
STRATEGY=copy_wallet
STRATEGY_PRESET=mo_money

# ---------------------------------------------------------------------------
# КОПИРОВАНИЕ КОШЕЛЬКА
# ---------------------------------------------------------------------------
COPY_WALLET=0x32ed2e546b187ca15e2841edc82b22c713cf8ec3

# exact  = столько же штук, сколько купил кошелёк (1:1, по умолчанию)
# scale  = штуки кошелька × COPY_SCALE
# fixed  = всегда COPY_SHARES штук
COPY_SIZE_MODE=exact
# 0.07, если не задано. COPY_SCALE=auto считает долю раз в сутки (только scale).
COPY_SCALE=0.07
COPY_SHARES=10

# Каждый рынок кошелька копируется. Пусто = все рынки.
# Пример сужения: COPY_SLUG_PREFIXES=btc-updown-5m,eth-updown
COPY_SLUG_PREFIXES=
COPY_MIN_PRICE=0.01
COPY_MAX_PRICE=0.99
# Секунды от открытия окна. 0 = без ограничения.
COPY_MIN_T=0
COPY_MAX_T=0
# 0 = без ограничения на число скопированных событий в одном окне.
COPY_MAX_PER_WINDOW=0
# Допустимое отклонение цены от цены кошелька при взятии стакана.
COPY_MAX_SLIP=0.03
# Искусственная задержка после сигнала; затем запрашивается свежий CLOB book.
# 0 = отключено, значения ограничены 0..30000 мс.
COPY_EXEC_LATENCY_MS=0
# Импортировать открытые позиции целевого кошелька при создании новой PAPER-базы.
COPY_IMPORT_POSITIONS=false

# Опрос ленты сделок и ленты активности (merge/split/redeem).
COPY_POLL_S=0.5
COPY_ACTIVITY_POLL_S=0.5
# Первый опрос — история, а не сигнал. false копирует и самый свежий экран.
COPY_SEED_ON_START=true
# Событие без метаданных рынка выбрасывается через столько секунд.
COPY_PENDING_TIMEOUT_S=120
# Сделка последних секунд окна доезжает после закрытия: сколько ещё ждать.
COPY_LATE_GRACE_S=5
COPY_MAX_ATTEMPTS=5
COPY_SEEN_LIMIT=20000

# Стопы по дневному убытку и серии убытков. Для 1:1 по умолчанию выключены:
# копия не должна останавливаться из-за плохого дня демо-счёта. Свободные
# деньги проверяются всегда.
COPY_USE_RISK_LIMITS=false
# Дополнительные потолки в долларах. 0 = без потолка.
COPY_WINDOW_CAP_USD=0
COPY_EXPOSURE_CAP_USD=0

AUTO_START=true

# ---------------------------------------------------------------------------
# МЕЙКЕР-ЛЕСТНИЦА (только при STRATEGY=maker_ladder)
# ---------------------------------------------------------------------------
ENABLED_ASSETS=BTC,ETH,SOL,XRP
ENABLED_TIMEFRAMES=5m,15m,1h,4h
ORDER_CLIP_USD=16
MAX_WINDOW_RISK_USD=80
MAX_TOTAL_EXPOSURE_USD=640
MAX_DAILY_LOSS_USD=160
MAX_CONSECUTIVE_LOSSES=10
MIN_MERGE_SHARES=1
# Вторая нога, когда первая уже куплена. Допустимо от 0.90 до 1.20.
PAIR_SUM_HEDGE=1.00
LADDER_RUNGS=6
LADDER_STEP=0.01
RUNG_SHARES=10
# Секунды, которые строка должна пролежать на полной ленте, прежде чем
# мы решим, что это maker BUY.
TAPE_SETTLE_S=6

# Одноразовая зачистка старых файлов на томе. Пусто = ничего не удалять.
# LEGACY_DB_DELETE=/data/polybot.db,/data/polybot.db-wal,/data/polybot.db-shm
# PAPER_RESET_ID: непустой новый ID выполняет одноразовый сброс PAPER с резервной копией.
# PAPER_RESET_ONCE сам по себе сброс не запускает.
PAPER_RESET_ID=
# PAPER_STATS_SINCE_TS — нижняя граница статистики, строки не удаляются.

# Газ merge/redeem в live без релеера. 0 = не выдумывать цену POL.
ONCHAIN_GAS_USD=0

POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_PIN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local default. On Railway the owner sets a fresh file and deletes the previous one:
# DB_PATH=/data/polybot_v11.db
DB_PATH=data/polybot.db
